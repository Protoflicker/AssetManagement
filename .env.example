# ============================================================
#  SESDIAN - local environment. Copy this file to ".env.local"
#  and fill in your values. ".env.local" is gitignored (never committed).
#  cp .env.example .env.local
# ============================================================

# Neon Postgres connection string.
# Neon dashboard -> your project -> "Connection Details" -> copy the
# connection string (the POOLED one is fine). Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Secret used to sign login tokens. Any long random string works for local.
# Must be IDENTICAL to the value used in production, otherwise every existing
# session is invalidated the moment you switch hosts.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Optional: WhatsApp auto-send gateway (Fonnte). Leave blank to use wa.me links.
FONNTE_TOKEN=

# Port the server listens on. Hostinger / Passenger inject this themselves;
# only set it locally when 3000 is already taken.
# PORT=3000
